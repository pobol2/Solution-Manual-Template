# Keep source files consistent across Windows, macOS and Linux.
* text=auto
*.tex text eol=lf
*.cls text eol=lf
*.sty text eol=lf
*.def text eol=lf
*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.yml text eol=lf
latexmkrc text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# The root PDF is the versioned example preview.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
