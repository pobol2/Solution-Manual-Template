# All compilation files go in build/; the final PDF is copied to the root.
build/
# Showcase editions (built locally and as CI artifacts, not committed).
/examples/showcase/exercises.pdf
/examples/showcase/answers.pdf

# Safety net for compilation outside latexmk.
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex
*.synctex.gz
*.synctex(busy)
*.bbl
*.blg
*.bcf
*.run.xml
*.lof
*.lot
*.nav
*.snm
*.vrb

# Editor / OS files.
.vscode/*
!.vscode/settings.json
*~
*.bak
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Standalone figure PDFs are generated from Figures/*.tex.
**/Figures/*.pdf
