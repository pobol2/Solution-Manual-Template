# Shared latexmk rules of the solution-manual framework: do not edit them in a
# project. They are loaded by the project's latexmkrc, which sets
# $framework_dir (the folder of this file, relative to the project root).
# latexmk runs from the project root, so every output stays in the project.

use Cwd qw(getcwd abs_path);
use File::Basename;
use File::Compare;
use File::Copy;
use File::Path qw(make_path);

$framework_dir = 'solution-manual' unless defined $framework_dir;

# Absolute path in the form understood by the TeX programs: a Perl from MSYS
# (Git Bash) or Cygwin returns /c/..., /cygdrive/c/... or /tmp/..., but MiKTeX
# needs C:/...
my %sm_native_cache;
sub sm_native_path {
    my $path = shift;
    $path =~ s{\\}{/}g;
    return $path unless $^O =~ /^(cygwin|msys)$/ && $path =~ m{^/};
    unless (exists $sm_native_cache{$path}) {
        my $native = `cygpath -m "$path" 2>/dev/null`;
        chomp $native;
        unless ($? == 0 && $native =~ m{^[A-Za-z]:/}) {
            ($native = $path) =~ s{^(?:/cygdrive)?/([A-Za-z])(/|$)}{$1:/};
        }
        $sm_native_cache{$path} = $native;
    }
    return $sm_native_cache{$path};
}

# Find SolutionManual.cls and SolutionFigure.cls in the framework folder
# (for both pdfLaTeX and the LuaLaTeX figure compilations).
ensure_path('TEXINPUTS', sm_native_path(abs_path($framework_dir)));

# Compile the manual with pdfLaTeX. The options are set here (not by the
# editor), so a terminal build and a VS Code build are identical, SyncTeX
# included.
$pdf_mode = 1;
# %P is the source file, after the -pretex code if any (see %editions)
set_tex_cmds('-synctex=1 -interaction=nonstopmode -file-line-error %O %P');

# Put every compilation file (aux, log, toc, synctex, pdf, ...) in build/
$out_dir  = 'build';
$aux_dir  = 'build';

# Completion report: with `completion tracking=true`, the manual writes
# build/<name>-completion.md, copied to this file of the project root (set it
# to '' in the project's latexmkrc to keep the report in build/ only).
$completion_report = 'COMPLETION.md' unless defined $completion_report;

# JSON problem index: always generated with completion tracking, optionally
# copied to this project-root file ('' keeps it in the build folder only).
$problems_json = '' unless defined $problems_json;

# The report can also be put inside a Markdown file of the project (e.g.
# 'README.md'), between the lines
#   <!-- completion report: begin -->
#   <!-- completion report: end -->
# ('' for none; both options can be used together).
$completion_readme = '' unless defined $completion_readme;

# Editions: other PDFs of the same sources in another solutions mode, built
# after each successful build of the manual, e.g.
#   %editions = ( exercises => 'hidden', answers => 'answers only' );
# builds build/exercises.pdf and build/answers.pdf, copied to the project root
# like main.pdf. The mode overrides any solutions=... of main.tex. Figures are
# shared; the completion report and JSON index are copied from main only.
%editions = () unless %editions;   # e.g. ( exercises => 'hidden', answers => 'answers only' )

# Name of the edition being built by sm_build_editions ('' for the manual).
# Its job gets the mode from SM_EDITION_SOLUTIONS and sets it with pre-TeX
# code, which defines \SolutionManualSolutions before the class (latexmk's
# -pretex option, set here: TeX code on a command line can lose its
# backslashes and braces, e.g. with the MSYS Perl of Git Bash). A space of the
# mode is written \space, for the same reason.
my $sm_edition = defined $ENV{SM_EDITION} ? $ENV{SM_EDITION} : '';
if ($sm_edition ne '' && defined $ENV{SM_EDITION_SOLUTIONS}) {
    (my $mode = $ENV{SM_EDITION_SOLUTIONS}) =~ s/ /\\space /g;
    $pre_tex_code = "\\def\\SolutionManualSolutions{$mode}";
}

# After a successful build, copy the final PDF to the project root, and the
# completion report and optional JSON index when they have changed, then
# build the editions. Set $copy_to_root to 0 to skip the copies (including
# report/index updates), e.g. on Overleaf, where the PDF is already in the
# output folder.
$copy_to_root = 1 unless defined $copy_to_root;
$success_cmd = 'internal sm_after_build %D %T';
sub sm_after_build {
    my ($pdf, $tex) = @_;
    copy_pdf_to_root($pdf);
    sm_build_editions($tex) if $sm_edition eq '';
    return 0;
}
sub copy_pdf_to_root {
    return 0 unless $copy_to_root;
    my $pdf = shift;
    copy($pdf, basename($pdf)) or warn "Could not copy $pdf to root: $!\n";
    return 0 if $sm_edition ne '';
    (my $report = $pdf) =~ s/\.pdf$/-completion.md/;
    if ($completion_report ne '' && -s $report
        && compare($report, $completion_report) != 0) {
        copy($report, $completion_report)
            or warn "Could not copy $report to $completion_report: $!\n";
    }
    sm_insert_report($report, $completion_readme)
        if $completion_readme ne '' && -s $report;
    (my $json = $pdf) =~ s/\.pdf$/-problems.json/;
    if ($problems_json ne '' && -s $json
        && compare($json, $problems_json) != 0) {
        copy($json, $problems_json)
            or warn "Could not copy $json to $problems_json: $!\n";
    }
    return 0;
}

# One latexmk job per edition, in the same project and build folder, with
# -jobname=<name> and the pre-TeX code above. SM_EDITION also tells the job's
# latexmkrc not to build the editions again. A failed edition gives a warning.
# latexmk does not see a change of pre-TeX code, so build/<name>-solutions.txt
# keeps the mode of the last successful build. A new mode removes the job's
# build/<name>.fdb_latexmk, which recompiles the edition (not the figures).
sub sm_build_editions {
    my $tex = shift;
    for my $name (sort keys %editions) {
        my $mode = $editions{$name};
        unless ($name =~ /^[A-Za-z0-9_-]+$/) {
            warn "Edition '$name' skipped: use letters, digits, - and _ in its name\n";
            next;
        }
        (my $base = basename($tex)) =~ s/\.tex$//;
        if ($name eq $base) {
            warn "Edition '$name' skipped: it would replace $base.pdf\n";
            next;
        }
        my $stamp = "$aux_dir/$name-solutions.txt";
        my $last = '';
        if (open(my $in, '<', $stamp)) {
            $last = <$in>;
            $last = '' unless defined $last;
            chomp $last;
            close($in);
        }
        unlink("$aux_dir/$name.fdb_latexmk") if $last ne $mode;
        print "Latexmk: building edition '$name' (solutions=$mode)\n";
        local $ENV{SM_EDITION} = $name;
        local $ENV{SM_EDITION_SOLUTIONS} = $mode;
        my $ret = system('latexmk', "-jobname=$name", $tex);
        if ($ret) {
            warn "Edition '$name' failed: see $out_dir/$name.log\n";
        }
        elsif ($last ne $mode) {
            if (open(my $out, '>', $stamp)) {
                print $out "$mode\n";
                close($out);
            }
        }
    }
}

# Replace the text between the completion report markers of the Markdown file
# $file with the report $report, keeping the file's line endings. The file is
# rewritten only when its content changes; problems only give a warning.
sub sm_insert_report {
    my ($report, $file) = @_;
    my $begin = '<!-- completion report: begin -->';
    my $end   = '<!-- completion report: end -->';
    my $text = sm_read_file($file);
    my $new  = sm_read_file($report);
    return unless defined $text && defined $new;
    # The marked text starts after the line of the begin marker and stops at
    # the start of the line of the end marker. Each marker is alone on its
    # line, outside fenced code blocks (where a README may document them).
    my ($pos, $start, $stop, $fence) = (0);
    for my $line (split /(?<=\n)/, $text) {
        if (defined $fence) {
            # Closed by a line of at least as many of the same characters
            my $char = substr($fence, 0, 1);
            undef $fence if $line =~ /^ {0,3}(\Q$char\E+)\s*$/
                         && length($1) >= length($fence);
        }
        elsif ($line =~ /^ {0,3}(`{3,}|~{3,})/) {
            $fence = $1;
        }
        elsif (!defined $start) {
            $start = $pos + length($line) if $line =~ /^\s*\Q$begin\E\s*$/;
        }
        elsif ($line =~ /^\s*\Q$end\E\s*$/) {
            $stop = $pos;
            last;
        }
        $pos += length($line);
    }
    unless (defined $stop) {
        warn "Completion report not inserted: $file needs the lines\n"
           . "  $begin\n  $end\n";
        return;
    }
    my $eol = $text =~ /\r\n/ ? "\r\n" : "\n";
    $new =~ s/\r?\n/$eol/g;
    $new =~ s/(?:$eol)*\z/$eol/;
    my $updated = substr($text, 0, $start) . $eol . $new . $eol
                . substr($text, $stop);
    return if $updated eq $text;
    if (open(my $out, '>:raw', $file)) {
        print $out $updated;
        close($out) or warn "Could not write $file: $!\n";
    }
    else {
        warn "Completion report not inserted: could not write $file: $!\n";
    }
}

# Content of $file as bytes, or undef (with a warning) if it cannot be read
sub sm_read_file {
    my $file = shift;
    open(my $in, '<:raw', $file) or do {
        warn "Completion report not inserted: could not read $file: $!\n";
        return undef;
    };
    local $/;
    my $text = <$in>;
    close($in);
    return defined $text ? $text : '';
}

# Normalized absolute path (forward slashes, no '.' segments), used to compare
# the paths written in .fls files.
sub sm_normalize_path {
    my $path = shift;
    $path =~ s{\\}{/}g;
    $path = sm_native_path($path) if $path =~ m{^/};
    $path = sm_native_path(getcwd()) . "/$path" unless $path =~ m{^[A-Za-z]:|^/};
    1 while $path =~ s{/\./}{/};
    $path =~ s{/+}{/}g;
    $path =~ s{/$}{};
    return $path;
}

# True if $path is $dir or inside it (case-insensitive on Windows)
sub sm_is_inside {
    my ($path, $dir) = @_;
    ($path, $dir) = (lc($path), lc($dir)) if $^O =~ /^(MSWin32|cygwin|msys)$/;
    return $path eq $dir || index($path, "$dir/") == 0;
}

# Figures/<name>.tex is a standalone LuaLaTeX document (using SolutionFigure.cls)
# compiled to Figures/<name>.pdf (intermediate files go in
# build/figures-aux). latexmk only reruns this when <name>.tex, or a project or
# framework file it reads (e.g. SolutionFigure.cls, mytheme.sty, myfigures.sty),
# changes or when the PDF is missing.
add_cus_dep('tex', 'pdf', 0, 'compile_figure');
sub compile_figure {
    my $base = shift;
    my $name = basename($base);
    my $dir  = "$out_dir/figures-aux";
    make_path($dir);
    my $ret = system('lualatex', '-interaction=nonstopmode', '-halt-on-error', '-recorder',
                     "-output-directory=$dir", "$base.tex");
    if ($ret) {
        warn "Figure $base.tex failed to compile: see $dir/$name.log\n";
        return $ret;
    }
    copy("$dir/$name.pdf", "$base.pdf") or die "Could not copy $dir/$name.pdf: $!\n";

    # Register the files read by the figure as extra sources, so that the figure
    # is rebuilt when one of them changes. Only files of the project and of the
    # framework are tracked (not the TeX distribution, nor build outputs).
    my $root      = sm_normalize_path(getcwd());
    my $framework = sm_normalize_path(abs_path($framework_dir));
    my $build     = sm_normalize_path($out_dir);
    my $source    = sm_normalize_path("$base.tex");
    if (open(my $fls, '<', "$dir/$name.fls")) {
        while (<$fls>) {
            next unless /^INPUT\s+(.+?)\s*$/;
            my $file = sm_normalize_path($1);
            next if sm_is_inside($file, $source) || sm_is_inside($file, $build);
            if (sm_is_inside($file, $root)) {
                # Project files are named relative to the root, as latexmk does
                rdb_ensure_file($rule, substr($file, length($root) + 1));
            }
            elsif (sm_is_inside($file, $framework)) {
                rdb_ensure_file($rule, $file);
            }
        }
        close($fls);
    }
    return 0;
}

1;
