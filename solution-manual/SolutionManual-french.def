%
% French texts of the solution manual: language=french.
% Read by SolutionManual.cls, and by SolutionFigure.cls for the number format.
% A space before ":" is written ~ (non-breaking); the class keeps babel-french
% from adding a second one.
\ProvidesFile{SolutionManual-french.def}[2026/10/22 v1.4.0 French texts for solution manuals]

\SolutionManualSetup{
    % Title page and footer
    title prefix={Solutions de},
    author label={Auteur},
    by label={par},
    month names={janvier, février, mars, avril, mai, juin, juillet, août,
        septembre, octobre, novembre, décembre},
    page label={Page},
    page of label={sur},
    % Contents and headings
    contents label={Table des matières},
    chapter label={Chapitre},
    % Problems
    problem label={Problème},
    solution label={Solution~:},
    answer label={Réponse au problème},
    verification label={Vérification~:},
    solutions title={Solutions},
    solution link label={Solution p.},
    chapter abbreviation={Chap.},
    section abbreviation={Sect.},
    problem abbreviation={Prob.},
    % Completion tracking
    not done label={À faire},
    done label={Fait},
    completion title={Progression},
    completion total label={Tous les problèmes},
    outside chapters label={(hors chapitres)},
    colon={~:},
    % Numbers (\pgfmathprintnumber, PGFPlots ticks): 1 234,5
    number format={use comma, 1000 sep={\,}},
}

\endinput
