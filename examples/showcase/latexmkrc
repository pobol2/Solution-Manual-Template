#
# Project build settings. The build rules are shared by every solution manual
# and live in the framework folder; outputs stay in this project
# (build/, Figures/*.pdf and the final PDF in this folder).

# Shared framework folder, relative to this showcase project.
$framework_dir = '../../solution-manual';

use File::Spec;
my $shared = File::Spec->rel2abs("$framework_dir/latexmkrc");
do $shared or die "Could not load $shared: ", ($@ || $!), "\n";

# Editions: exercises.pdf (questions only) and answers.pdf (questions and
# final answers), built after main.pdf (see ../../docs/editions.md).
%editions = ( exercises => 'hidden', answers => 'answers only' );

# Project-specific latexmk settings can be added below, e.g. the name of the
# completion report copied to this folder ('' to keep it in build/ only):
# $completion_report = 'COMPLETION.md';
# or a Markdown file to insert the report into, between the lines
# <!-- completion report: begin --> and <!-- completion report: end -->:
# $completion_readme = 'README.md';
